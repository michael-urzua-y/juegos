# Copiar a deploy/api.env y completar. Ese archivo NO se sube a git.

# Administrador inicial: se crea solo si aún no existe ninguno.
# La clave queda como temporal: al primer ingreso pide cambiarla.
ADMIN_USERNAME=michael
ADMIN_PASSWORD=pon-aqui-una-clave-larga

# Contacto que ven los clientes para renovar (número con código de país → botón de WhatsApp)
