# Opcionales (valores por defecto)
# GRACE_DAYS=3            días de gracia tras el vencimiento
# INITIAL_DAYS=30         días de servicio de un cliente nuevo
# SESSION_IDLE_DAYS=30    una sesión sin uso se libera sola
# BACKUP_KEEP=14          respaldos diarios que se conservan
# TZ=America/Santiago
